//PAYEXTR  JOB (ACCT),'PAYMENT EXTRACT',CLASS=A,MSGCLASS=X
//* DAILY EXTRACT OF SETTLED PAYMENTS FOR THE GL FEED - RUNS AFTER EOD
//STEP010  EXEC PGM=PAYX0100
//INFILE   DD DSN=PROD.PAYMENTS.SETTLED.DAILY,DISP=SHR
//OUTFILE  DD DSN=PROD.GL.FEED.PAYMENTS(+1),DISP=(NEW,CATLG,DELETE)
//STEP020  EXEC PGM=SORT,COND=(4,LT)
//SORTIN   DD DSN=PROD.GL.FEED.PAYMENTS(+1),DISP=SHR
//SORTOUT  DD DSN=PROD.GL.FEED.SORTED,DISP=OLD
