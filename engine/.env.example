# Optional: lets the Repair Analyst ask Claude about addresses the rules cannot resolve.
# AI suggestions always go to a human reviewer; they are never auto-applied.
ANTHROPIC_API_KEY=
HYNIQE_MODEL=claude-sonnet-5-5
# Server
PORT=4317
HYNIQE_TICK_MS=700
# Use a file path to keep state between restarts, e.g. data/hyniqe.db
HYNIQE_DB=:memory:
